# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Đây là cấu hình WEB của Firebase (công khai theo thiết kế, nằm trong bundle JS).
# Nó KHÔNG phải bí mật: an toàn đến từ Security Rules + hạn chế API key, không phải từ file này.
# TUYỆT ĐỐI không đặt Service Account / Admin SDK private key ở đây.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
