rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm dùng chung ----------
    function signedIn() { return request.auth != null; }

    // Thành viên = đã nhập đúng "mã gia đình" (xem members/{uid} bên dưới).
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function incoming() { return request.resource.data; }
    function validName(d) {
      return d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 24;
    }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }

    // ---------- config: chứa bí mật gia đình, client KHÔNG đọc/ghi được ----------
    // Tạo thủ công trong Console: config/access { code: "<mã gia đình>" }
    // Rules vẫn đọc được tài liệu này để đối chiếu mã.
    match /config/{docId} {
      allow read, write: if false;
    }

    // ---------- members: cổng vào ----------
    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && incoming().keys().hasOnly(['code', 'joinedAt'])
        && incoming().joinedAt == request.time
        && incoming().code is string
        && incoming().code == get(/databases/$(database)/documents/config/access).data.code;
      allow update, delete: if false;
    }

    // ---------- users: hồ sơ, chỉ chủ sở hữu đọc/ghi ----------
    match /users/{uid} {
      allow read: if isMember() && request.auth.uid == uid;

      allow create: if isMember() && request.auth.uid == uid
        && incoming().keys().hasOnly(['displayName', 'createdAt', 'lastSeen'])
        && validName(incoming())
        && incoming().createdAt == request.time
        && incoming().lastSeen == request.time;

      allow update: if isMember() && request.auth.uid == uid
        && incoming().diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastSeen', 'lastMessageAt'])
        && validName(incoming())
        && (!incoming().diff(resource.data).affectedKeys().hasAny(['lastSeen'])
            || incoming().lastSeen == request.time)
        && (!incoming().diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
            || incoming().lastMessageAt == request.time);

      allow delete: if false;
    }

    // ---------- messages: chat chung của gia đình ----------
    match /messages/{messageId} {
      allow read: if isMember();

      allow create: if isMember()
        && incoming().keys().hasOnly(['senderId', 'senderName', 'content', 'createdAt'])
        && incoming().senderId == request.auth.uid
        // Không giả mạo tên: phải trùng tên trong hồ sơ của chính mình.
        && incoming().senderName == get(userPath(request.auth.uid)).data.displayName
        && incoming().content is string
        && incoming().content.size() <= 500
        && incoming().content.matches('.*\\S.*')
        && incoming().createdAt == request.time
        // Giới hạn tốc độ: tối thiểu 1 giây giữa 2 tin; client ghi kèm users/{uid}.lastMessageAt trong cùng batch.
        && request.time > get(userPath(request.auth.uid)).data.get('lastMessageAt', timestamp.date(2000, 1, 1)) + duration.value(1, 's')
        && getAfter(userPath(request.auth.uid)).data.lastMessageAt == request.time;

      allow update, delete: if false;
    }

    // ---------- games: danh mục (nguồn chính là src/data/games.js), chỉ đọc ----------
    match /games/{gameId} {
      allow read: if isMember();
      allow write: if false;
    }

    // ---------- rooms: CHƯA mở ghi vì chưa có gameplay ----------
    // Khi làm game, thay "allow create, update, delete: if false" bằng quy tắc theo host/players.
    match /rooms/{roomId} {
      allow read: if isMember();
      allow create, update, delete: if false;
    }

    // Mọi đường dẫn khác: từ chối.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
